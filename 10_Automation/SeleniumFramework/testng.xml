<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="School Management Automation Suite"
       verbose="1"
       parallel="false">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <!--
        TestNG groups: smoke / sanity / regression are declared via
        @Test(groups = "...") on individual test methods. Groups can be
        selected at runtime with: mvn test -Dgroups=smoke
    -->
    <test name="Login Module">

        <classes>

            <class name="tests.LoginTest"/>
            <class name="tests.RoleLoginTest"/>

        </classes>

    </test>

    <test name="Dashboard Module">

        <classes>

            <class name="tests.DashboardTest"/>

        </classes>

    </test>

    <test name="Navigation Module">

        <classes>

            <class name="tests.NavigationTest"/>

        </classes>

    </test>

    <test name="Student Module">

        <classes>

            <class name="tests.StudentTest"/>

        </classes>

    </test>

    <test name="Academics Module">

        <classes>

            <class name="tests.AcademicsTest"/>

        </classes>

    </test>

    <test name="Fees Module">

        <classes>

            <class name="tests.FeesTest"/>

        </classes>

    </test>

</suite>
